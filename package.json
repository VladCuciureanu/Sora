{
  "name": "sora",
  "version": "0.1.0",
  "private": true,
  "description": "Upscale CBZ comic book archives with AI upscaling engines",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "sora": "dist/main.js"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "biome lint",
    "format": "biome check --write",
    "check": "biome check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26",
    "typescript": "^7.0.2"
  }
}
